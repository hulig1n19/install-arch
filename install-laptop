#!/usr/bin/env bash
set -euo pipefail

#######################################################################
# Kolory + funkcje komunikatów + pasek postępu
#######################################################################

WHITE="\e[97m"
RED="\e[31m"
GREEN="\e[32m"
YELLOW="\e[33m"
BLUE="\e[34m"
CYAN="\e[36m"
RESET="\e[0m"

info()    { echo -e "${BLUE}[INFO]${RESET} $1"; }
ok()      { echo -e "${GREEN}[OK]${RESET} $1"; }
warn()    { echo -e "${YELLOW}[WARN]${RESET} $1"; }
error()   { echo -e "${RED}[ERROR]${RESET} $1"; }

progress_bar() {
    local duration=$1
    local i=0
    local bar=""
    while [ $i -le $duration ]; do
        bar=$(printf "%-${i}s" "#" | tr ' ' '#')
        printf "\r${CYAN}[%s%-${duration}s]${RESET}" "$bar" ""
        sleep 0.05
        i=$((i+1))
    done
    echo ""
}

#######################################################################
# Sprawdzenie i automatyczne montowanie partycji EFI (/boot)
#######################################################################

info "Sprawdzam montowanie partycji EFI (/boot)..."
if ! mountpoint -q /boot; then
    EFI_PART=$(lsblk -no NAME,FSTYPE | grep -i "vfat" | awk '{print "/dev/" $1}' | head -n 1)
    if [ -n "$EFI_PART" ]; then
        sudo mount "$EFI_PART" /boot
        ok "Automatycznie zamontowano partycję EFI ($EFI_PART) do /boot."
    else
        warn "Nie znaleziono partycji vfat dla /boot. Upewnij się, że jest zamontowana!"
    fi
else
    ok "Partycja /boot jest już poprawnie zamontowana."
fi

sudo mkdir -p /boot/loader/entries

#######################################################################
# Banner ARCH LINUX (minimalistyczny)
#######################################################################

arch_logo() {
    echo -e "${CYAN}"
    echo "=================================="
    echo "        ARCH LINUX - KDE Plasma      "
    echo "       Skrypt Instalacyjny 2026      "
    echo "               29.08.2026          "
    echo "=================================="
    echo ""
    echo -e "${YELLOW}Autor Skryptu: Krzysiek Wierciuch (Hulig1n19)${RESET}"
    echo ""
    echo -e "${RED}Godzina Utworzenia Skryptu: 16:02${RESET}"
    echo ""
    echo -e "${GREEN}Data Utworzenia Skryptu: 29.08.2026${RESET}"
    echo ""
    echo -e "${WHITE}Utworzono Specjalnie Dla: Lenovo x260 ThinkPad${RESET}"
    echo ""
}

arch_logo
sleep 1

#######################################################################
# 1. Aktualizacja systemu
#######################################################################

info "Aktualizacja systemu..."
progress_bar 20
sudo pacman -Syu --noconfirm
ok "System zaktualizowany."


#######################################################################
# 2. Instalacja Plasma Desktop + SDDM
#######################################################################

info "Instaluję Plasma Desktop i komponenty KDE..."

PLASMA_PKGS=(
  plasma-desktop
  kde-gtk-config
  konsole
  dolphin
  kate
  nano
  kscreen
  sddm
  sddm-kcm
)

for pkg in "${PLASMA_PKGS[@]}"; do
  if ! pacman -Qi "$pkg" >/dev/null 2>&1; then
    info "Instaluję: $pkg"
    sudo pacman -S --noconfirm "$pkg"
  else
    warn "Pominięto — $pkg już jest."
  fi
done
ok "Plasma Desktop i komponenty KDE zainstalowane."


#######################################################################
# 3. Włączenie menedżera logowania SDDM
#######################################################################

info "Włączam SDDM..."
if ! systemctl is-enabled --quiet sddm 2>/dev/null; then
    sudo systemctl enable sddm
    ok "SDDM włączony."
else
    warn "SDDM już jest włączony."
fi


#######################################################################
# 4. Instalacja pakietów pacman
#######################################################################

PACMAN_PKGS=(
  git base-devel less wget firefox firefox-i18n-pl flatpak power-profiles-daemon
  plasma-nm plasma-pa bluedevil plasma-workspace-wallpapers plasma-browser-integration
  ark p7zip unrar unzip lrzip lzop zip papirus-icon-theme capitaine-cursors discover
  kdeplasma-addons kdeconnect sshfs noto-fonts-cjk noto-fonts-extra cantarell-fonts hunspell-pl
  lib32-mesa lib32-vulkan-intel clinfo kwallet-pam kwalletmanager vim kclock cmake ninja vulkan-intel
  qbittorrent elisa thunderbird putty okular gsmartcontrol intel-media-driver
  gwenview kdegraphics-thumbnailers ffmpegthumbs mangohud btop spectacle qt5-virtualkeyboard
  kolourpaint gnome-maps gnome-calendar kcalc sweeper vlc vlc-plugins-all libreoffice-fresh
  libreoffice-fresh-pl gnome-disk-utility ntfs-3g exfatprogs dosfstools btrfs-progs xfsprogs f2fs-tools
  wine dosbox gst-plugins-bad gst-plugins-base gst-plugins-good gst-plugins-ugly libgphoto2 samba sane
  unixodbc wine-gecko wine-mono linux-lts-headers pacman-contrib gamemode gamescope breeze-gtk
  dolphin-plugins kfind ttf-jetbrains-mono ttf-fira-code dunst
)

info "Instalacja pakietów pacman..."
for pkg in "${PACMAN_PKGS[@]}"; do
  if ! pacman -Qi "$pkg" >/dev/null 2>&1; then
    info "Instaluję: $pkg"
    sudo pacman -S --noconfirm "$pkg"
  else
    warn "Pominięto — $pkg już jest."
  fi
done
ok "Pakiety pacman zainstalowane."


#######################################################################
# 5. Flatpak + Flathub
#######################################################################

info "Konfiguruję Flatpak..."
if ! flatpak remote-list | grep -q '^flathub'; then
  sudo flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
  ok "Dodano Flathub."
else
  warn "Flathub już istnieje."
fi


#######################################################################
# 6. Usługi (tylko jeśli nieaktywne)
#######################################################################

info "Sprawdzam usługi..."
if ! systemctl is-active --quiet power-profiles-daemon 2>/dev/null; then
  sudo systemctl enable --now power-profiles-daemon
  ok "power-profiles-daemon uruchomiony."
else
  warn "power-profiles-daemon już działa."
fi


#######################################################################
# 7. Instalacja yay (wsparcie dla konta root)
#######################################################################

info "Sprawdzam yay..."
if ! command -v yay >/dev/null 2>&1; then
  info "Instaluję yay..."
  rm -rf /tmp/yay
  git clone https://aur.archlinux.org/yay.git /tmp/yay
  chmod -R 777 /tmp/yay

  if [ "$EUID" -eq 0 ]; then
      warn "Uruchomiono jako root. Używam tymczasowego użytkownika do instalacji yay..."
      useradd -m -d /tmp/builduser builduser || true
      echo 'builduser ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/builduser
      sudo -u builduser bash -c "cd /tmp/yay && makepkg -si --noconfirm"
      rm -f /etc/sudoers.d/builduser
      userdel -r builduser || true
  else
      cd /tmp/yay
      makepkg -si --noconfirm
      cd - >/dev/null
  fi
  ok "yay zainstalowany."
else
  warn "yay już jest."
fi


#######################################################################
# 8. Instalacja z AUR (zabezpieczenie przed rootem)
#######################################################################

AUR_PKGS=(
  xone-dkms
)

for pkg in "${AUR_PKGS[@]}"; do
  if ! pacman -Qi "$pkg" >/dev/null 2>&1; then
    info "Instaluję z AUR: $pkg"
    if [ "$EUID" -eq 0 ] && [ -n "${SUDO_USER:-}" ]; then
      sudo -u "$SUDO_USER" yay -S --noconfirm "$pkg"
    else
      yay -S --noconfirm "$pkg"
    fi
  fi
done


#######################################################################
# 9. SDDM — konfiguracja
#######################################################################

info "Konfiguruję SDDM..."
SDDM_FILE="/etc/sddm.conf"
SDDM_BLOCK=$'[General]\nInputMethod=qtvirtualkeyboard\n\n[Theme]\nCurrent=breeze'

sudo touch "$SDDM_FILE"

if grep -Fq "[General]" "$SDDM_FILE" && grep -Fq "InputMethod=qtvirtualkeyboard" "$SDDM_FILE" && grep -Fq "[Theme]" "$SDDM_FILE" && grep -Fq "Current=breeze" "$SDDM_FILE"; then
    warn "Blok SDDM już istnieje."
else
    info "Dodaję blok SDDM..."
    sudo sed -i ':a;/^\s*$/{$d;N;ba}' "$SDDM_FILE"
    printf "%s\n" "$SDDM_BLOCK" | sudo tee -a "$SDDM_FILE" >/dev/null
    ok "Blok SDDM dodany."
fi


#######################################################################
# 10. Silent Boot (UKI Cmdline) + mkinitcpio (i915, brak fsck)
#######################################################################

info "Konfiguruję cichy rozruch (Silent Boot) oraz mkinitcpio..."
MKCONF="/etc/mkinitcpio.conf"
sudo touch "$MKCONF"

INITRAMFS_CHANGED=0

# 1. Tworzenie parametru cmdline dla UKI ukrywającego napisy
sudo mkdir -p /etc/cmdline.d
CMDLINE_FILE="/etc/cmdline.d/quiet.conf"
QUIET_PARAMS="quiet loglevel=3 rd.systemd.show_status=auto rd.udev.log_level=3 vt.global_cursor_default=0 systemd.show_status=false"

if [ ! -f "$CMDLINE_FILE" ] || ! grep -q "quiet loglevel=3" "$CMDLINE_FILE"; then
    info "Tworzę plik z parametrami cichego rozruchu w /etc/cmdline.d/quiet.conf..."
    echo "$QUIET_PARAMS" | sudo tee "$CMDLINE_FILE" >/dev/null
    INITRAMFS_CHANGED=1
    ok "Dodano parametry cichego rozruchu."
else
    warn "Parametry cichego rozruchu już istnieją w /etc/cmdline.d/quiet.conf."
fi

# 2. Moduł i915 w mkinitcpio.conf (zapobiega miganiu obrazu)
if grep -q "^MODULES=" "$MKCONF"; then
    if grep -q "^MODULES=.*i915" "$MKCONF"; then
        warn "i915 już jest w MODULES."
    else
        info "Dodaję i915 do MODULES..."
        sudo sed -i \
          -e 's/^MODULES=(\s*\(.*\))/MODULES=(\1 i915)/' \
          -e 's/^MODULES=(\s*/MODULES=(/' \
          "$MKCONF"
        INITRAMFS_CHANGED=1
    fi
else
    info "Dodaję nową linię MODULES=(i915)..."
    LINE=$(grep -n "^# MODULES" "$MKCONF" | cut -d: -f1 || true)
    if [ -n "$LINE" ]; then
        sudo sed -i "$((LINE+1)) i MODULES=(i915)" "$MKCONF"
    else
        printf "\n# MODULES\nMODULES=(i915)\n" | sudo tee -a "$MKCONF" >/dev/null
    fi
    INITRAMFS_CHANGED=1
fi

# 3. Usuwanie hooka fsck z HOOKS (ukrywa komunikat /dev/sda2: clean)
if grep -q "\bfsck\b" "$MKCONF"; then
    info "Usuwam hook 'fsck' z mkinitcpio.conf..."
    sudo sed -i -e 's/\bfsck\b//g' -e 's/  */ /g' -e 's/( /(/' "$MKCONF"
    INITRAMFS_CHANGED=1
    ok "Hook 'fsck' usunięty."
else
    warn "Hook 'fsck' został już usunięty z HOOKS."
fi

# 4. Generowanie obrazu UKI z uwzględnieniem cmdline.d i zmian w mkinitcpio
if [ "$INITRAMFS_CHANGED" = "1" ]; then
    info "Przebudowuję obraz UKI (mkinitcpio -P)..."
    sudo mkinitcpio -P
    ok "Obraz UKI przebudowany pomyślnie."
else
    warn "Initramfs / UKI bez zmian."
fi


#######################################################################
# 11. systemd-boot — timeout 0
#######################################################################

info "Ustawiam timeout 0 w systemd-boot..."
LOADER_CONF="/boot/loader/loader.conf"

if [ ! -f "$LOADER_CONF" ]; then
    info "Tworzę brakujący plik loader.conf..."
    sudo bash -c "echo 'timeout 0' > '$LOADER_CONF'"
    ok "Utworzono loader.conf z timeout 0."
else
    sudo sed -i \
        -e 's/^[[:space:]]*timeout[[:space:]]*=[[:space:]]*[0-9]\+/timeout 0/' \
        -e 's/^[[:space:]]*timeout[[:space:]]\+[0-9]\+/timeout 0/' \
        "$LOADER_CONF"
    ok "Timeout ustawiony na 0."
fi


#######################################################################
# 12. Gamemode
#######################################################################

info "Konfiguruję gamemode..."
GAMEMODE_CFG="/etc/gamemode.ini"

sudo touch "$GAMEMODE_CFG"
sudo sed -i '1{/^[[:space:]]*$/d}' "$GAMEMODE_CFG"

HAS_GENERAL=$(grep -Fq "[general]" "$GAMEMODE_CFG" && echo yes || echo no)
HAS_RENICE=$(grep -Fq "renice=10" "$GAMEMODE_CFG" && echo yes || echo no)
HAS_CPU=$(grep -Fq "[cpu]" "$GAMEMODE_CFG" && echo yes || echo no)
HAS_GOV=$(grep -Fq "governor=performance" "$GAMEMODE_CFG" && echo yes || echo no)
HAS_GPU=$(grep -Fq "[gpu]" "$GAMEMODE_CFG" && echo yes || echo no)
HAS_GPU_OPT=$(grep -Fq "apply_gpu_optimisations=accept-responsibility" "$GAMEMODE_CFG" && echo yes || echo no)
HAS_GPU_DEV=$(grep -Fq "gpu_device=0" "$GAMEMODE_CFG" && echo yes || echo no)

if [ "$HAS_GENERAL" = yes ] && [ "$HAS_RENICE" = yes ] && [ "$HAS_CPU" = yes ] && [ "$HAS_GOV" = yes ] && [ "$HAS_GPU" = yes ] && [ "$HAS_GPU_OPT" = yes ] && [ "$HAS_GPU_DEV" = yes ]; then
    warn "Konfiguracja gamemode już istnieje."
else
    info "Uzupełniam konfigurację gamemode..."
    [ "$HAS_GENERAL" = no ] && printf "[general]\n" | sudo tee -a "$GAMEMODE_CFG" >/dev/null
    [ "$HAS_RENICE" = no ] && printf "renice=10\n" | sudo tee -a "$GAMEMODE_CFG" >/dev/null
    [ "$HAS_CPU" = no ] && printf "\n[cpu]\n" | sudo tee -a "$GAMEMODE_CFG" >/dev/null
    [ "$HAS_GOV" = no ] && printf "governor=performance\n" | sudo tee -a "$GAMEMODE_CFG" >/dev/null
    [ "$HAS_GPU" = no ] && printf "\n[gpu]\n" | sudo tee -a "$GAMEMODE_CFG" >/dev/null
    [ "$HAS_GPU_OPT" = no ] && printf "apply_gpu_optimisations=accept-responsibility\n" | sudo tee -a "$GAMEMODE_CFG" >/dev/null
    [ "$HAS_GPU_DEV" = no ] && printf "gpu_device=0\n" | sudo tee -a "$GAMEMODE_CFG" >/dev/null
    ok "Gamemode skonfigurowany."
fi


#######################################################################
# 13. Czyszczenie cache
#######################################################################

info "Czyszczę cache pacmana, yay i flatpaka..."

sudo pacman -Sc --noconfirm >/dev/null 2>&1 || true

if [ "$EUID" -eq 0 ] && [ -n "${SUDO_USER:-}" ]; then
    sudo -u "$SUDO_USER" yay -Sc --noconfirm >/dev/null 2>&1 || true
else
    yay -Sc --noconfirm >/dev/null 2>&1 || true
fi

flatpak uninstall --unused -y >/dev/null 2>&1 || true
flatpak remove --unused -y >/dev/null 2>&1 || true
flatpak repair --user -y >/dev/null 2>&1 || true
flatpak repair --system -y >/dev/null 2>&1 || true

ok "Cache wyczyszczony."


#######################################################################
# 14. Finalna aktualizacja
#######################################################################

info "Finalna aktualizacja systemu..."
sudo pacman -Syu --noconfirm
ok "System gotowy."

echo -e "${GREEN}=== Operacja zakończona sukcesem ===${RESET}"
echo ""
info "Restart systemu nastąpi za 10 sekund."
echo ""

for i in {10..1}; do
    echo "Restart za $i..."
    sleep 1
done

info "Restartuję system..."
sudo systemctl reboot
